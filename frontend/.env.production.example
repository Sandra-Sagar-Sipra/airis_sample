# =============================================================================
# AIRIS Frontend — Production Environment Template (Vercel)
# =============================================================================
# Set in Vercel → Project → Settings → Environment Variables, then redeploy.
# Production site: https://airis-sample1.vercel.app
# NEVER commit .env.local or .env.production.local to source control.
# =============================================================================

# Production API (direct — no Next.js proxy in production builds)
# Railway backend origin only (no /api/v1 suffix); client appends `/api/v1`.
NEXT_PUBLIC_API_BASE_URL=https://<your-railway-backend>.up.railway.app
NEXT_PUBLIC_API_BACKEND_URL=https://<your-railway-backend>.up.railway.app
API_BACKEND_URL=https://<your-railway-backend>.up.railway.app

# WebSocket for LiveKit / real-time features
NEXT_PUBLIC_WS_API_BASE_URL=wss://<your-railway-backend>.up.railway.app/api/v1

# Enable candidate management module in production
NEXT_PUBLIC_USE_CANDIDATE_MANAGEMENT=false
