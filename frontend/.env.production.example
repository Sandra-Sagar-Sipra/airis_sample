# =============================================================================
# AIRIS Frontend — Production (Vercel: https://airis-sample1.vercel.app)
# =============================================================================
# Set in Vercel → Settings → Environment Variables, then Redeploy (build-time vars).
# =============================================================================

# --- Option A (recommended): same-origin proxy — avoids CORS in the browser ---
# Browser calls https://airis-sample1.vercel.app/api/v1/... ; Vercel proxies to Railway.
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_PROXY_TARGET=https://<your-railway-backend>.up.railway.app
API_BACKEND_URL=https://<your-railway-backend>.up.railway.app
NEXT_PUBLIC_API_BACKEND_URL=https://<your-railway-backend>.up.railway.app

# --- Option B: direct browser → Railway (requires Railway CORS_ORIGINS) ---
# NEXT_PUBLIC_API_BASE_URL=https://<your-railway-backend>.up.railway.app
# NEXT_PUBLIC_API_BACKEND_URL=https://<your-railway-backend>.up.railway.app

# WebSocket (direct to Railway when using Option A or B)
NEXT_PUBLIC_WS_API_BASE_URL=wss://<your-railway-backend>.up.railway.app/api/v1

NEXT_PUBLIC_USE_CANDIDATE_MANAGEMENT=false
